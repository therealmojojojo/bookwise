# MCP Test Server Configuration
# Copy this to .env and fill in your values

# =============================================================================
# AUTH0 CONFIGURATION (REQUIRED)
# =============================================================================

# Your Auth0 tenant domain (e.g., 'your-tenant.us.auth0.com')
# Find this in: Auth0 Dashboard → Settings → General → Domain
AUTH0_DOMAIN=your-tenant.us.auth0.com

# API Identifier from Auth0 (typically your MCP server URL)
# Find this in: Auth0 Dashboard → APIs → Your API → Settings → Identifier
AUTH0_AUDIENCE=https://bookwise.mjjj.space

# Optional: Pre-configured client credentials for testing
# Claude.ai will register dynamically via DCR, so these are optional
# Find these in: Auth0 Dashboard → Applications → Your App → Settings
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# Public URL where this server is accessible
# Must match the URL you give to Claude.ai when adding custom connector
MCP_SERVER_URL=https://bookwise.mjjj.space

# Server port (default: 8767)
# Use different port from main BookWise server (8766)
PORT=8767

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# AUTH0 SETUP CHECKLIST
# =============================================================================
#
# □ Created Auth0 account at https://auth0.com
# □ Created API in Auth0 Dashboard
# □ Enabled "Dynamic Client Registration" in API settings
# □ Added scopes: bookwise:read, bookwise:execute
# □ Set token expiration to 24 hours (86400 seconds)
# □ Created test user in Auth0
# □ (Optional) Created test application for manual testing
#
# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
#
# □ Server accessible at public URL (Cloudflare Tunnel / ngrok / Cloud Run)
# □ HTTPS enabled (required for OAuth)
# □ OAuth discovery endpoint working: GET /.well-known/oauth-protected-resource
# □ MCP HEAD endpoint working: HEAD /
# □ MCP initialize working without auth: POST / {"method": "initialize"}
#
# =============================================================================

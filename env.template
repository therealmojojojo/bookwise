# Book Quality Scoring System - Environment Configuration Template
# Copy this file to .env and update with your actual paths

# ============================================================================
# CALIBRE DATABASE CONFIGURATION
# ============================================================================

# Full path to your Calibre library directory
# This directory contains the metadata.db file
CALIBRE_LIBRARY_PATH=/path/to/your/calibre/library

# Full path to the Calibre database file
# Usually: {CALIBRE_LIBRARY_PATH}/metadata.db
CALIBRE_DB_PATH=/path/to/your/calibre/library/metadata.db

# Path to calibredb command-line tool
# macOS: /Applications/calibre.app/Contents/MacOS/calibredb
# Linux: /usr/bin/calibredb or /opt/calibre/calibredb
# Windows: C:\Program Files\Calibre2\calibredb.exe
CALIBREDB_PATH=/Applications/calibre.app/Contents/MacOS/calibredb

# ============================================================================
# PROJECT PATHS
# ============================================================================

# Full path to the datasources directory
# Usually: {PROJECT_ROOT}/datasources
DATASOURCES_DIR=/path/to/bookwise/datasources

# Full path to the output directory
# Usually: {PROJECT_ROOT}/output
OUTPUT_DIR=/path/to/bookwise/output

# ============================================================================
# SCORING CONFIGURATION
# ============================================================================

# Minimum quality score threshold for "high quality" classification
# Recommended: 50 (Good tier)
MIN_QUALITY_SCORE=50

# Maximum books to process in batch operations
# Set to 0 for unlimited
MAX_BOOKS_TO_PROCESS=0

# ============================================================================
# AI ENRICHMENT CONFIGURATION
# ============================================================================

# Anthropic API Key (for Claude)
# Get your key at: https://console.anthropic.com/
# Used for generating tags, themes, and enhanced descriptions
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
# Used for generating vector embeddings (text-embedding-3-large)
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB storage path
# Directory where vector embeddings will be stored
# Standard macOS location: ~/Library/Application Support/bookwise/vectors
# Linux: ~/.local/share/bookwise/vectors
# Windows: %APPDATA%\bookwise\vectors
CHROMADB_PATH=~/Library/Application Support/bookwise/vectors

# Enrichment output directory
# Usually: {OUTPUT_DIR}/enrichment
ENRICHMENT_DIR=/path/to/bookwise/output/enrichment

# Minimum quality score for enrichment
# Only books with this score or higher will be enriched
# Set to 0 to enrich all scored books
# Recommended: 0 (enrich all), 50 (top tier only), or 70 (outstanding+)
ENRICHMENT_MIN_SCORE=0

# Rate limiting delay (seconds)
# Delay between API calls to avoid rate limits
# Recommended: 1.0 (safe), 0.5 (faster), 2.0 (conservative)
ENRICHMENT_RATE_LIMIT=1.0

# Batch size for testing
# Set to 0 for unlimited (process all books)
# Recommended: 10 for initial testing, then 0 for production
ENRICHMENT_BATCH_SIZE=0

# ============================================================================
# LIBRARIAN API CONFIGURATION
# ============================================================================

# E-reader book delivery - Shared folder for exporting books
# This is where books will be exported when using the send_to_ereader API
# Can be a local folder, network share, or cloud-synced folder
# Examples:
#   macOS: /Users/username/Library/Mobile Documents/com~apple~CloudDocs/Books
#   Linux: /home/username/shared/ebooks or /mnt/ereader
#   Windows: C:\Users\username\OneDrive\Books
EREADER_EXPORT_FOLDER=

# API Security - API Key for authentication (leave blank to disable auth)
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If not set, API will run in development mode without authentication
BOOKWISE_API_KEY=

# Server configuration
PORT=8000
HOST=0.0.0.0
RELOAD=False  # Set to True for development with auto-reload

# ============================================================================
# DEBUG & LOGGING
# ============================================================================

# Enable verbose logging (True/False)
DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO


# BookWise Librarian API Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
CALIBRE_DB_PATH=/path/to/your/Calibre/metadata.db
CALIBRE_LIBRARY_PATH=/path/to/your/Calibre

# =============================================================================
# CALIBRE BINARY
# =============================================================================
CALIBREDB_PATH=/Applications/calibre.app/Contents/MacOS/calibredb

# =============================================================================
# AI ENRICHMENT CONFIGURATION
# =============================================================================

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (for embeddings)
OPENAI_API_KEY=sk-proj-your-key-here

# ChromaDB storage path
CHROMADB_PATH=/path/to/chromadb/storage

# =============================================================================
# E-READER DELIVERY
# =============================================================================

# Shared folder for exporting books (can be Google Drive, Dropbox, etc.)
EREADER_EXPORT_FOLDER=/path/to/shared/folder

# =============================================================================
# LIBRARIAN API CONFIGURATION
# =============================================================================

# Server settings
PORT=8000
HOST=0.0.0.0

# BookWise API Security (leave empty to disable auth)
BOOKWISE_API_KEY=

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Quality scores CSV path (if you have pre-computed scores)
QUALITY_SCORES_PATH=/path/to/quality_scores.csv

# Output directory for generated data
OUTPUT_DIR=/path/to/output

# Enrichment settings
ENRICHMENT_DIR=/path/to/enrichment/output
ENRICHMENT_MIN_SCORE=0
ENRICHMENT_RATE_LIMIT=1.0
ENRICHMENT_BATCH_SIZE=0

# Minimum quality score for classification
MIN_QUALITY_SCORE=50
MAX_BOOKS_TO_PROCESS=0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (will create directory if it doesn't exist)
LOG_FILE=~/Library/Application Support/bookwise/logs/bookwise.log

# =============================================================================
# CALIBRE IMPORT TRACKING
# =============================================================================

# Status file for tracking Calibre imports (prevents re-tagging unchanged books)
CALIBRE_IMPORT_STATUS_FILE=~/Library/Application Support/bookwise/calibre_import_status.json
